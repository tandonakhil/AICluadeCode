# Nested project repos are independent git repos, not tracked by the root repo
projects/*/dev/
projects/*/prod/

# Python
__pycache__/
*.pyc
.venv/
.deliverables-venv/
# Same thing under the name deliverables-agent actually creates it with — the
# pattern above only matched the hyphenated spelling, so a real run left an
# untracked venv sitting in the repo root.
.venv-deliverables/
.pytest_cache/

# Node / Next.js
node_modules/
.next/

# OS
.DS_Store

# Office lock/temp files (created when a generated .pptx/.docx/.xlsx is opened)
~$*.pptx
~$*.docx
~$*.xlsx
