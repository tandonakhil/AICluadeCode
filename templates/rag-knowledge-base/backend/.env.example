LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Embeddings always use OpenAI regardless of LLM_PROVIDER (Anthropic has no
# embeddings API) — OPENAI_API_KEY is required even on an Anthropic-only project.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
